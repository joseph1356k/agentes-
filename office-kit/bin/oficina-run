#!/usr/bin/env bash
# oficina-run: ejecuta un comando y deja evidencia verificable.
#   oficina-run [--label <etiqueta>] [--cwd <dir>] [--timeout <seg>] -- <comando...>
# Escribe .oficina/evidence/<id>.json y <id>.log y imprime un recibo:
#   EVIDENCE id=ev_... exit=<código> duration_ms=<n> log=<ruta>
# El código de salida de oficina-run es el del comando.
set -uo pipefail

label="run"; cwd=""; timeout_s=""
while [ $# -gt 0 ]; do
  case "$1" in
    --label) label="$2"; shift 2 ;;
    --cwd) cwd="$2"; shift 2 ;;
    --timeout) timeout_s="$2"; shift 2 ;;
    --) shift; break ;;
    -h|--help) sed -n '2,7p' "$0"; exit 0 ;;
    *) break ;;
  esac
done
[ $# -gt 0 ] || { echo "oficina-run: falta el comando. Uso: oficina-run [--label x] -- <comando>" >&2; exit 64; }

# localizar raíz y carpeta de evidencia (mismo criterio que los hooks)
root="${OFICINA_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
evdir="${OFICINA_EVIDENCE_DIR:-$root/.oficina/evidence}"
mkdir -p "$evdir"

rand="$(od -An -N3 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n' || printf '%06x' $RANDOM)"
id="ev_$(date +%s)_${rand}"
log="$evdir/$id.log"
meta="$evdir/$id.json"
cmd_str="$*"
started="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
t0="$(date +%s%3N 2>/dev/null || python3 -c 'import time;print(int(time.time()*1000))')"

[ -n "$cwd" ] && cd "$cwd"
{
  echo "# oficina-run $id"
  echo "# label: $label"
  echo "# cwd: $(pwd)"
  echo "# started: $started"
  echo "# command: $cmd_str"
  echo "# ----"
} > "$log"

set +e
if [ -n "$timeout_s" ] && command -v timeout >/dev/null 2>&1; then
  timeout "$timeout_s" bash -lc "$cmd_str" 2>&1 | tee -a "$log"
  code=${PIPESTATUS[0]}
else
  bash -lc "$cmd_str" 2>&1 | tee -a "$log"
  code=${PIPESTATUS[0]}
fi
set -e

t1="$(date +%s%3N 2>/dev/null || python3 -c 'import time;print(int(time.time()*1000))')"
dur=$(( t1 - t0 ))
echo "# ----" >> "$log"
echo "# exit: $code · duration_ms: $dur" >> "$log"

jq -n --arg id "$id" --arg label "$label" --arg command "$cmd_str" --arg cwd "$(pwd)" \
      --arg started "$started" --argjson duration_ms "$dur" --argjson exit_code "$code" --arg log "$log" \
      --arg agent "${OFICINA_AGENT:-}" --arg session "${CLAUDE_SESSION_ID:-}" '
  {id:$id,label:$label,command:$command,cwd:$cwd,started_at:$started,duration_ms:$duration_ms,exit_code:$exit_code,log_path:$log,
   agent:(if $agent=="" then null else $agent end), session_id:(if $session=="" then null else $session end)}' > "$meta"

echo "EVIDENCE id=$id exit=$code duration_ms=$dur log=$log"
exit "$code"
