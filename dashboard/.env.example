# Proyecto Supabase de la oficina (NUNCA el del producto). Ambos valores son públicos por diseño (RLS protege los datos).
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<clave publicable sb_publishable_... o anon>
# No hace falta service role: la ingesta valida su token en la base (se genera en /team).
